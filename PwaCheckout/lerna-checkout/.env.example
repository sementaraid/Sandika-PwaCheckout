# Copy this file to .env and fill in the values.
# `yarn dev` / `yarn prod` copy .env into packages/frontend and packages/backend.

# Backend (packages/backend)
SESSION_SECRET=change-me
KEY=32-character-encryption-key-here
ALGORITHM=AES-256-CBC
GRAPHQL_ENDPOINT=https://your-swift-store.example.com/graphql

# Frontend (packages/frontend)
REACT_APP_BO_ENDPOINT=https://your-swift-store.example.com
REACT_APP_LOCALE=id-ID
REACT_APP_LOCALE_CURRENCY=IDR
